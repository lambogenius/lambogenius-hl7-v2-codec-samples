{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "description": "POST an ER7 message (Content-Type: text/plain)."
      }
    },
    "actions": {
      "Decode_HL7": {
        "type": "ServiceProvider",
        "description": "ER7 to one XML document (MSH inside the message root), with no schema: allowSchemaless gives generic names (PID_5, PID_5_0) and no groups, instead of AR.",
        "inputs": {
          "parameters": {
            "message": "@{triggerBody()}",
            "indent": true,
            "allowSchemaless": true
          },
          "serviceProviderConfiguration": {
            "connectionName": "lamboHl7Codec",
            "operationId": "decode",
            "serviceProviderId": "/serviceProviders/lamboHl7Codec"
          }
        },
        "runAfter": {}
      },
      "Response": {
        "type": "Response",
        "kind": "Http",
        "description": "Returns everything Decode produced: success, ackCode, xml, ack, messages[] and errors[].",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@body('Decode_HL7')"
        },
        "runAfter": {
          "Decode_HL7": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
