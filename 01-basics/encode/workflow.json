{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "description": "POST the HL7 XML (MSH and the body in one document) or its JSON form. Add &validate=true to the URL to validate it against the schema first."
      }
    },
    "actions": {
      "Encode_HL7": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "message": "@{triggerBody()}",
            "validateXml": "@equals(coalesce(triggerOutputs()?['queries']?['validate'], 'false'), 'true')"
          },
          "serviceProviderConfiguration": {
            "connectionName": "lamboHl7Codec",
            "operationId": "encode",
            "serviceProviderId": "/serviceProviders/lamboHl7Codec"
          }
        },
        "runAfter": {}
      },
      "Response": {
        "type": "Response",
        "kind": "Http",
        "description": "200 with the ER7 message, or 400 with the errors.",
        "inputs": {
          "statusCode": "@if(body('Encode_HL7')?['success'], 200, 400)",
          "headers": {
            "Content-Type": "@{if(body('Encode_HL7')?['success'], 'text/plain', 'application/json')}"
          },
          "body": "@if(body('Encode_HL7')?['success'], body('Encode_HL7')?['hl7Message'], body('Encode_HL7')?['errors'])"
        },
        "runAfter": {
          "Encode_HL7": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
